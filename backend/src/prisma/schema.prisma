// What this does: defines your PostgreSQL tables and relations using Prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STORE_KEEPER
  CASHIER
  SALESPERSON
  MANAGER
  ACCOUNTANT
  HR
  CEO
}

// What this does: groups accounts into standard financial statement categories
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// What this does: identifies the source of a journal entry (manual vs system)
enum JournalSource {
  MANUAL
  SALE
  EXPENSE
  PAYROLL
  RETURN
  STOCK
  OTHER
}

enum StockType {
  IN
  OUT
  DAMAGE
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(STORE_KEEPER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // What this does: when true, user must change password after login
  mustChangePassword Boolean @default(false)

  // What this does: tracks when password last changed (audit/security)
  passwordChangedAt DateTime?

  // What this does: tracks last login time
  lastLoginAt DateTime?

  stockTransactions StockTransaction[]
  auditLogs         AuditLog[]

  // What this does: links cashier to sales
  sales          Sale[]
  saleReturns    SaleReturn[]
  attendances    Attendance[]
  salaryAdvances SalaryAdvance[]
  payrollRuns    PayrollRun[]
  expenses       Expense[]

  // What this does: links who updated/deleted expense (soft delete + audit)
  expensesUpdated Expense[]      @relation("ExpenseUpdatedBy")
  expensesDeleted Expense[]      @relation("ExpenseDeletedBy")
  cashierShifts   CashierShift[]
  salesSdcRows    SalesSdcRow[]  @relation("UserSalesSdcRows")

  // What this does: links journal entries to the user who created them
  journalEntries JournalEntry[] @relation("JournalEntryCreatedBy")
}

model Product {
  id  String @id @default(uuid())
  sku String @unique

  // What this does: unique spare-part identifier (optional first to avoid breaking old data)
  partNumber String? @unique

  name      String
  unit      String  @default("pcs")
  costPrice Decimal @db.Decimal(12, 2)
  sellPrice Decimal @db.Decimal(12, 2)
  minStock  Int     @default(0)

  // What this does: spare part attributes
  brand              String? // e.g., TVS, Honda, Yamaha
  category           String? // e.g., Brake, Chain, Engine, Electrical
  modelCompatibility String? // e.g., "TVS HLX 125, Bajaj Boxer 150"

  // What this does: motorbike-specific attributes (optional)
  chassisNumber String?  @unique
  modelYear     Int?
  weightKg      Decimal? @db.Decimal(10, 2)
  color         String?
  branchName    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  inventory    Inventory[]
  transactions StockTransaction[]
  // What this does: allows Product -> SaleItem relation (POS line items)
  saleItems    SaleItem[]
  returnItems  SaleReturnItem[]

  @@index([name])
  @@index([brand])
  @@index([partNumber])
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  inventory    Inventory[]
  transactions StockTransaction[]

  // What this does: allows a location (Main Store) to have many shelf/bins (A1-01, A1-02...)
  bins        StorageBin[]
  // What this does: allows Location -> SaleItem relation
  saleItems   SaleItem[]
  returnItems SaleReturnItem[]
}

model Inventory {
  id         String @id @default(uuid())
  productId  String
  locationId String

  // What this does: exact shelf/bin where the product is stored
  binId String?

  quantity  Int      @default(0)
  // What this does: gives existing rows a value, and Prisma will keep updating it later
  updatedAt DateTime @default(now()) @updatedAt

  product  Product     @relation(fields: [productId], references: [id])
  location Location    @relation(fields: [locationId], references: [id])
  bin      StorageBin? @relation(fields: [binId], references: [id])

  @@unique([productId, locationId, binId])
}

model StockTransaction {
  id         String    @id @default(uuid())
  type       StockType
  productId  String
  locationId String
  quantity   Int
  unitCost   Decimal?  @db.Decimal(12, 2) // required for IN, optional others
  reason     String? // required for DAMAGE, optional others
  createdBy  String
  createdAt  DateTime  @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  user     User     @relation(fields: [createdBy], references: [id])

  @@index([createdAt])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // e.g. "CREATE_PRODUCT", "STOCK_IN"
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model StorageBin {
  id String @id @default(uuid())

  // What this does: the visible shelf code you will label in your store
  code String @unique // e.g. "A1-01"

  // What this does: optional description (helps staff)
  description String? // e.g. "Brake pads section"

  // What this does: connects shelf/bin to a store location like "Main Store"
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  inventory   Inventory[]
  // What this does: allows StorageBin -> SaleItem relation
  saleItems   SaleItem[]
  returnItems SaleReturnItem[]
  createdAt   DateTime         @default(now())
}

// What this does: supported payment methods for POS
enum PaymentMethod {
  CASH
  MOMO
  CARD
  BANK
  OTHER
}

enum BuyerType {
  INDIVIDUAL
  COMPANY
}

enum EbmStatus {
  PENDING
  SIGNED
  FAILED
  CANCELLED
  CREDITED
  NOT_REQUIRED
}

// What this does: holds an invoice/sale record
// What this does: tracks cashier daily shifts and closing reconciliation (expected vs counted)
enum ShiftStatus {
  OPEN
  CLOSED
}

model CashierShift {
  id        String @id @default(uuid())
  cashierId String
  cashier   User   @relation(fields: [cashierId], references: [id])

  status   ShiftStatus @default(OPEN)
  openedAt DateTime    @default(now())
  closedAt DateTime?

  note String?

  // What this does: expected totals from system sales during shift
  expectedCash  Decimal @default(0) @db.Decimal(12, 2)
  expectedMomo  Decimal @default(0) @db.Decimal(12, 2)
  expectedCard  Decimal @default(0) @db.Decimal(12, 2)
  expectedBank  Decimal @default(0) @db.Decimal(12, 2)
  expectedOther Decimal @default(0) @db.Decimal(12, 2)
  expectedTotal Decimal @default(0) @db.Decimal(12, 2)

  // What this does: cashier counted totals at end of shift
  countedCash  Decimal @default(0) @db.Decimal(12, 2)
  countedMomo  Decimal @default(0) @db.Decimal(12, 2)
  countedCard  Decimal @default(0) @db.Decimal(12, 2)
  countedBank  Decimal @default(0) @db.Decimal(12, 2)
  countedOther Decimal @default(0) @db.Decimal(12, 2)
  countedTotal Decimal @default(0) @db.Decimal(12, 2)

  // What this does: differences (counted - expected)
  diffCash  Decimal @default(0) @db.Decimal(12, 2)
  diffMomo  Decimal @default(0) @db.Decimal(12, 2)
  diffCard  Decimal @default(0) @db.Decimal(12, 2)
  diffBank  Decimal @default(0) @db.Decimal(12, 2)
  diffOther Decimal @default(0) @db.Decimal(12, 2)
  diffTotal Decimal @default(0) @db.Decimal(12, 2)

  salesCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // What this does: links all sales made during this shift
  sales Sale[]
}

// What this does: links a Sale to the cashier shift for proper daily closing
model Sale {
  id        String @id @default(uuid())
  invoiceNo String @unique

  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  note          String?
  createdAt     DateTime      @default(now())

  buyerType  BuyerType @default(INDIVIDUAL)
  buyerTin   String?
  buyerName  String?
  buyerPhone String?

  cashierId String
  cashier   User   @relation(fields: [cashierId], references: [id])

  // ✅ NEW
  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id])

  items   SaleItem[]
  returns SaleReturn[]

  ebmStatus           EbmStatus @default(PENDING)
  ebmInvoiceNo        String?   @unique
  ebmReceiptSignature String?
  ebmQrPayload        String?
  ebmIssuedAt         DateTime?
}

model SalesSdcRow {
  id                 String    @id @default(uuid())
  sdcId              String
  buyerTin           String?
  buyerName          String?
  saleDate           DateTime?
  receiptType        String?
  itemName           String?
  quantity           Decimal?  @db.Decimal(14, 3)
  unitPrice          Decimal?  @db.Decimal(18, 2)
  taxableSupplyPrice Decimal?  @db.Decimal(18, 2)
  vat                Decimal?  @db.Decimal(18, 2)
  summaryAmount      Decimal?  @db.Decimal(18, 2)
  uploadedById       String?
  uploadedBy         User?     @relation("UserSalesSdcRows", fields: [uploadedById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@unique([sdcId, itemName])
  @@index([saleDate])
}

// What this does: stores each line item on an invoice (and which bin it came from)
model SaleItem {
  id         String @id @default(uuid())
  saleId     String
  productId  String
  locationId String
  binId      String?

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale     Sale       @relation(fields: [saleId], references: [id])
  product  Product    @relation(fields: [productId], references: [id])
  location Location   @relation(fields: [locationId], references: [id])
  bin      StorageBin? @relation(fields: [binId], references: [id])

  createdAt DateTime @default(now())
}

model SaleReturn {
  id        String   @id @default(uuid())
  saleId    String
  reason    String
  createdAt DateTime @default(now())

  ebmStatus    EbmStatus @default(PENDING)
  ebmSignature String?
  ebmQrPayload String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  sale  Sale             @relation(fields: [saleId], references: [id])
  items SaleReturnItem[]
}

model SaleReturnItem {
  id         String @id @default(uuid())
  returnId   String
  productId  String
  locationId String
  binId      String
  quantity   Int

  return   SaleReturn @relation(fields: [returnId], references: [id])
  product  Product    @relation(fields: [productId], references: [id])
  location Location   @relation(fields: [locationId], references: [id])
  bin      StorageBin @relation(fields: [binId], references: [id])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

// FILE: src/prisma/schema.prisma
// What this does: adds professional HR Attendance lateness fields + payroll lateness deduction fields

// =====================
// HR MODELS (add/ensure)
// =====================

// What this does: adds badge employee code + trainee/staff type for HR
enum EmploymentType {
  STAFF
  TRAINEE
}

model Employee {
  id String @id @default(uuid())

  // ✅ NEW: badge ID shown on employee card/badge
  employeeCode String @unique // e.g. "EMP-001", "KGL-TR-04"

  fullName   String
  nationalId String? @unique
  tin        String? @unique
  phone      String?
  position   String?

  // ✅ NEW: trainee or staff
  employmentType EmploymentType @default(STAFF)

  // ✅ Optional but useful
  hireDate DateTime? // when started

  baseSalary  Decimal  @db.Decimal(12, 2)
  bankName    String?
  bankAccount String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  attendance   Attendance[]
  advances     SalaryAdvance[]
  payrollItems PayrollItem[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now())

  // ✅ NEW: lateness tracking
  checkInTime DateTime? // optional check-in time
  isLate      Boolean   @default(false)
  lateMinutes Int       @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
}

enum AdvanceStatus {
  APPROVED
  CANCELLED
}

model SalaryAdvance {
  id         String        @id @default(uuid())
  employeeId String
  amount     Decimal       @db.Decimal(12, 2)
  date       DateTime      @default(now())
  reason     String?
  status     AdvanceStatus @default(APPROVED)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([date])
}

// What this does: tracks sold motorbikes promotions/imported sales data
model MotorbikePromotion {
  id             String    @id @default(uuid())
  countingNumber String?
  date           DateTime?
  customerName   String?
  chassisNumber  String    @unique
  plateNumber    String?
  model          String?
  phoneNumber    String?
  delivered      Boolean   @default(false)
  stubPaid       Boolean   @default(false)
  branchName     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum PayrollStatus {
  DRAFT
  FINAL
}

model PayrollRun {
  id        String        @id @default(uuid())
  year      Int
  month     Int
  createdAt DateTime      @default(now())
  status    PayrollStatus @default(DRAFT)

  generatedById String
  generatedBy   User   @relation(fields: [generatedById], references: [id])

  totalNet Decimal @default(0) @db.Decimal(12, 2)

  items PayrollItem[]

  @@unique([year, month])
}

model PayrollItem {
  id           String @id @default(uuid())
  payrollRunId String
  employeeId   String

  baseSalary  Decimal @db.Decimal(12, 2)
  daysPresent Int
  workingDays Int
  grossPay    Decimal @db.Decimal(12, 2)

  // ✅ NEW: lateness rule storage (3 lates => 1 day deduction)
  lateCount     Int     @default(0)
  lateDeduction Decimal @default(0) @db.Decimal(12, 2)

  advanceDeduction Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal @default(0) @db.Decimal(12, 2)
  netPay           Decimal @db.Decimal(12, 2)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
}

// What this does: categorizes company expenses for reporting/cashflow
enum ExpenseCategory {
  RENT
  UTILITIES
  TRANSPORT
  SALARY_PAYOUT
  STOCK_PURCHASE
  MAINTENANCE
  TAX
  OFFICE
  OTHER
}

// What this does: stores an expense record (cash outflow)
model Expense {
  id            String          @id @default(uuid())
  date          DateTime        @default(now())
  amount        Decimal         @db.Decimal(12, 2)
  category      ExpenseCategory @default(OTHER)
  paymentMethod PaymentMethod   @default(CASH)

  vendor      String?
  description String?
  referenceNo String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  // ✅ NEW: soft delete fields
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])

  // ✅ NEW: edit tracking (optional but professional)
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
  updatedBy   User?    @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])

  @@index([date])
  @@index([category])
  @@index([paymentMethod])
  @@index([isDeleted])
}

// =====================
// ACCOUNTING MODELS
// =====================

model Account {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  type      AccountType
  category  String?
  isCash    Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines JournalLine[]
}

model JournalEntry {
  id          String        @id @default(uuid())
  date        DateTime      @default(now())
  memo        String?
  reference   String?
  source      JournalSource @default(MANUAL)
  sourceId    String?
  createdById String?
  createdBy   User?         @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([source])
}

model JournalLine {
  id        String  @id @default(uuid())
  entryId   String
  accountId String
  debit     Decimal @default(0) @db.Decimal(12, 2)
  credit    Decimal @default(0) @db.Decimal(12, 2)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([entryId])
}
